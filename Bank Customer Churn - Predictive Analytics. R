################Model 3- Logistic Regression ######################

set.seed(33)

# Feature Scaling excluding the response variable and binary predictors
strata_train[-c(2,7,8,10,11,12)] = scale(strata_train[-c(2,7,8,10,11,12)]) 
strata_test[-c(2,7,8,10,11,12)]= scale(strata_test[-c(2,7,8,10,11,12)])

#fit the model on training set 
logistic_model <- glm(Exited~ ., family="binomial", data=strata_train)

#provides summary information on how the model performs on training set
summary(logistic_model)

#the below provides the odds ratio
lm_odds_ratio <- exp(coef(logistic_model))

print(lm_odds_ratio)

#shows important variables for predicting churn
varImp(logistic_model)

#predict the class on test data 

# Since the type is equal to response, it predicts probabilities 

logistic_pred_test = predict(logistic_model, newdata=strata_test, type="response")

# Change the probabilities to binary results to use confusion matrix
logistic_pred_bin <- ifelse(logistic_pred_test >0.5, 1, 0)

#the below calculates the accuracy of the model on the test set

lm_pred_accuracy <- mean(logistic_pred_bin == strata_test$Exited )

# Evaluate model using confusion matrix

logistic_confmatrix <- table(strata_test$Exited, logistic_pred_bin)

print(logistic_confmatrix)

# Use ROCR library to create an ROC-AUC Curve

#calculate the auc value 
library(ROCR)

ROCPred <- prediction(logistic_pred_bin, strata_test$Exited)
ROCPerf <- performance(ROCPred, measure = "tpr",
                      x.measure = "fpr")

auc <- performance(ROCPred, measure = "auc")
auc <- auc@y.values[[1]]

# Plot the curve
plot(ROCPer)
plot(ROCPer, colorize = TRUE,
     print.cutoffs.at = seq(0.1, by = 0.1),
     main = "Logistic regression - ROC CURVE")
abline(a = 0, b = 1)

