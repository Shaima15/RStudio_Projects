#install necessary packages 
install.packages("readxl")
install.packages("ROCR")
install.packages("rsample")
install.packages("caret")
install.packages("rpart.plot")
install.packages('randomForest')
install.packages('e1071')
install.packages('tidyverse')
install.packages('glmnet')
install.packages('dplyr')
install.packages("glmnet")

#use readxl library to read the dataset
library(readxl)
churn = read_excel('Churn_new_outlier.xlsx')

#convert the exited column to a factor to allow for further analysis 
churn$Exited <- factor(churn$Exited, levels =c(1,0))

#check class distribution 
class_dist <- table(churn$Exited) 

#Use caret library to over sample the minority class to create
#a balanced data set 

library(caret)
churn_oversamp <- upSample(churn, churn$Exited)

#The oversampling method above created a column called 'class' that is the 
#same as the 'Exited' class, so the latter will be removed and class will be
#renamed to 'Exited'

churn_oversamp <- upSample(churn[, -10], churn$Exited, yname = "Exited")

#check the distribution of the class after oversampling 

table(churn_oversamp$Exited) 

#Perform stratified sampling using initial_split where 80% of data is used for
#training and 20% is used for testing

library(rsample)

strata_sample <- initial_split(churn_oversamp, prop = 0.80, strata = Exited) 

#access the training set and store it in a variable

strata_train <- training(strata_sample)

#access the testing set and store it in a variable

strata_test <- testing(strata_sample)

################Model 1- Decision tree ######################

###train the model using the training set 

#set the seed to a specific number to ensure that the model shows same result 
#whenever we run it

set.seed(123)

#Use repart library to train the model on the training set

library(rpart)

Dtree_model <- rpart(Exited ~ ., data = strata_train, method = "class")

print(Dtree_model)

#Use prp to plot the decision tree model to show the results

library(rpart.plot)

prp(Dtree_model,
    faclen=0, #This ensures that full names are used for factor labels
    extra=1, #This shows number of observations for each terminal node
    roundint=T) #This rounds the results to integers

# To prune the tree, the below line will identify the best complexity parameter
#value to use. The goal is to find a cp value that will reduce xerror i.e.
#cross-validated error

best_cp <- Dtree_model$cptable[which.min(Dtree_model$cptable[,"xerror"])
                                     ,"CP"]

#This line will provide a pruned tree based on the best cp value
Dtree_prune <- prune(Dtree_model, cp=best_cp)

print(Dtree_prune)

#plot the pruned tree
prp(Dtree_prune,
    faclen=0, 
    extra=1, 
    roundint=T) 

#checks important variables when predicting the response variable 
print(Dtree_prune$variable.importance)

#Use the model to predict on test set
Dtree_test_pred <-predict(Dtree_prune, strata_test, type = 'class')

#check model performance on Test set using confusion matrix 
Dtree_confmatrix <- confusionMatrix(strata_test$Exited, Dtree_test_pred)

print(Dtree_confmatrix)

#Assess model performance 

#Extract precision and recall from confusion matrix to calculate
#F1 scores

recall_dtree <- Dtree_confmatrix$byClass["Sensitivity"] 
precision_dtree <- Dtree_confmatrix$byClass["Pos Pred Value"]  

#creates a function that takes precision and recall as arguments to 
#calculate F1 scores. The function calculates it using its respective formula,
#but it won't calculate it if the sum of precision and recall is equal to 0
#in order to avoid division by 0

f1_calc <- function(precision, recall) {
  if (precision + recall ==0) {
    return (0)
  } 
  return(2*(precision * recall)/(precision + recall))
}

F1_dtree <- f1_calc(precision_dtree,recall_dtree) 

#Kfold cross validation (cv)

#The below uses trainControl function to set the required parameter values to 
#perform cross validation. Here, I am performing 10 fold cross validation

Dtree_fitcontrol <- trainControl(method = "cv", number= 10)

#Uses the set parameters to train the model using the training set

Dtree_Fit_cv <-train(Exited ~ ., data=strata_train, 
                  method= "rpart", 
                  trControl = Dtree_fitcontrol)


#Now predict on the Testing set  

Dtree_pred_cv = predict(Dtree_Fit_cv, newdata = strata_test) 

#Check the model's confusion matrix
Dtree_confmatrix_cv = confusionMatrix(table(strata_test[, 12], Dtree_pred_cv)) 

print(Dtree_confmatrix_cv)

#retrieve recall, precision, and calculate F1 scores 

recall_dtree_cv <- Dtree_confmatrix_cv$byClass["Sensitivity"] 
precision_dtree_cv <- Dtree_confmatrix_cv$byClass["Pos Pred Value"]  

F1_dtree_cv <- f1_calc(precision_dtree_cv,recall_dtree_cv) 

################Model 2- Random forest ##########################

set.seed(20)

library(randomForest)

#The importance has been set to true to show which predictors are crucial
#for determining Exited i.e response variable. ntree is the number of trees. 

rforest_model<- randomForest(Exited ~ ., ntree = 350, data = strata_train,
                             importance = TRUE)

#check the result of the model 

print(rforest_model)

#plot the random tree result 

plot(rforest_model, main = "Random forest model results")

#Tune the Random forest model.  
#The above model used 3 variables at each split 
#The below line finds the optimal number of variables 

#step factor of 2 wil increment the value of variables to try by 2 each time

tuneRF(strata_train[,c(1:11)], strata_train$Exited, stepfactor =2) 

#build a tuned random forest model 
# the below uses 350 trees and uses 6 variables at each split 

rf_tuned_model <- randomForest(Exited ~ ., ntree=350, mtry = 6, data = strata_train)

#make predictions on test set

rf_tuned_pred <-predict(rf_tuned_model, strata_test, type = 'class')

#check model performance using confusion matrix 

